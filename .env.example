# Copy to `.env` for local development. Never commit `.env`, and never put a real
# password in this file — it is tracked in git.
#
# On Vercel these go in Project → Settings → Environment Variables (Production +
# Preview). `.env` is NOT uploaded by the build; anything missing there is missing
# at runtime, and every page below `/` reads the database on request.

# --- Database (MongoDB) -----------------------------------------------------
# Local: a mongod you run yourself. NOTE: a standalone mongod does NOT support
# multi-document transactions, and the submit/grading path uses them. Run a single-node
# replica set locally (`mongod --replSet rs0`, then `rs.initiate()`) or point at Atlas.
MONGODB_URI="mongodb://127.0.0.1:27017/examprep?replicaSet=rs0"
#
# Vercel: an Atlas connection string. Atlas clusters are replica sets, so transactions work.
# Add the database name to the path — without it Mongoose connects to "test".
# Network Access must allow 0.0.0.0/0, because Vercel functions have no fixed egress IP.
#
#   MONGODB_URI="mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/examprep?retryWrites=true&w=majority"

# --- NextAuth ----------------------------------------------------------------
# Local:
NEXTAUTH_URL="http://localhost:3000"
# Vercel: the deployment's own origin, e.g. "https://examprep.vercel.app" (no trailing slash).

# Required in production — NextAuth throws without it, which 500s every page.
# Generate one: `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# --- Email (password reset) --------------------------------------------------
# Optional. `lib/mail.ts` no-ops when EMAIL_SERVER_HOST is unset, so password-reset mail
# is simply not sent; nothing else breaks.
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="apikey"
EMAIL_SERVER_PASSWORD="replace-me"
EMAIL_FROM="ExamPrep <no-reply@examprep.app>"

# --- App -----------------------------------------------------------------
# Used to build the password-reset link. Set to the same origin as NEXTAUTH_URL.
APP_URL="http://localhost:3000"
