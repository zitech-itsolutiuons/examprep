// ExamPrep — Prisma schema
// PostgreSQL database schema for a full-stack CBT exam preparation platform.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum Role {
  STUDENT
  ADMIN
  GUEST
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  ABANDONED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// Which repeated landing-page list a HomeBlock row belongs to.
enum HomeBlockKind {
  STAT
  FEATURE
  STEP
  FAQ
  LINK
}

// A STAT either shows the literal in `HomeBlock.value` (MANUAL) or a figure counted
// from the live database at render time.
enum HomeMetric {
  MANUAL
  STUDENTS
  SUBJECTS
  QUESTIONS
  ATTEMPTS
  PASS_RATE
  AVERAGE_SCORE
}

// ---------------------------------------------------------------------------
// AUTH / USERS
// ---------------------------------------------------------------------------

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  passwordHash   String
  role           Role      @default(STUDENT)
  avatarUrl      String?
  isActive       Boolean   @default(true)
  emailVerified  DateTime?
  // GUEST rows only: when their code-granted session lapses. Also drives the retention
  // sweep, which deletes a guest 30 days after this timestamp.
  guestExpiresAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  attempts         ExamAttempt[]
  flaggedQuestions FlaggedQuestion[]
  progress         UserProgress[]
  resetTokens      PasswordResetToken[]
  sessions         Session[]
  createdSubjects  Subject[]            @relation("SubjectCreatedBy")
  createdQuestions Question[]           @relation("QuestionCreatedBy")
  homePageEdits    HomePage[]           @relation("HomePageUpdatedBy")
  auditLogs        AuditLog[]

  @@index([email])
  @@index([role, guestExpiresAt])
  @@map("users")
}

// Server-side session store (used alongside NextAuth JWT/db strategy)
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// CONTENT: SUBJECTS / TOPICS / QUESTIONS
// ---------------------------------------------------------------------------

model Subject {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  imageUrl    String?
  durationMin Int      @default(30) // exam time limit in minutes
  passMark    Int      @default(50) // percentage required to "pass"
  isPublished Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User       @relation("SubjectCreatedBy", fields: [createdById], references: [id])
  topics    Topic[]
  questions Question[]
  attempts  ExamAttempt[]

  @@index([slug])
  @@index([isPublished, isActive])
  @@map("subjects")
}

model Topic {
  id          String   @id @default(cuid())
  name        String
  description String?
  subjectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions Question[]

  @@unique([subjectId, name])
  @@map("topics")
}

model Question {
  id            String       @id @default(cuid())
  subjectId     String
  topicId       String?
  text          String       @db.Text
  type          QuestionType @default(SINGLE_CHOICE)
  difficulty    Difficulty   @default(MEDIUM)
  explanation   String?      @db.Text // shown on review, especially for wrong answers
  points        Int          @default(1)
  isActive      Boolean      @default(true)
  createdById   String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  subject         Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic           Topic?             @relation(fields: [topicId], references: [id], onDelete: SetNull)
  createdBy       User               @relation("QuestionCreatedBy", fields: [createdById], references: [id])
  options         QuestionOption[]
  userAnswers     UserAnswer[]
  flaggedBy       FlaggedQuestion[]

  @@index([subjectId])
  @@index([topicId])
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  text       String   @db.Text
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)

  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userAnswers UserAnswer[] @relation("SelectedOption")

  @@index([questionId])
  @@map("question_options")
}

// ---------------------------------------------------------------------------
// EXAM ATTEMPTS / GRADING
// ---------------------------------------------------------------------------

model ExamAttempt {
  id            String        @id @default(cuid())
  userId        String
  subjectId     String
  status        AttemptStatus @default(IN_PROGRESS)
  score         Int?          // raw points scored
  totalPoints   Int?          // total points possible at time of attempt
  percentage    Float?        // score / totalPoints * 100
  correctCount  Int?
  incorrectCount Int?
  unansweredCount Int?
  startedAt     DateTime      @default(now())
  submittedAt   DateTime?
  timeSpentSec  Int?
  isAutoSubmitted Boolean     @default(false) // true when the timer expired rather than the student submitting
  attemptNumber Int           // Nth attempt for this user+subject, preserved forever

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  answers UserAnswer[]
  flags   FlaggedQuestion[]

  @@index([userId, subjectId])
  @@index([status])
  @@map("exam_attempts")
}

// One row per question per attempt, created up-front when the attempt starts. That
// write is the question-set snapshot: deactivating or retopic-ing a question later
// never changes which questions a past attempt contained. `isCorrect` stays null
// until the attempt is graded — true = right, false = answered wrong, null = unanswered.
model UserAnswer {
  id               String   @id @default(cuid())
  attemptId        String
  questionId       String
  selectedOptionId String?  // for single-choice/true-false
  selectedOptionIds String[] @default([]) // for multiple-choice (answer ids)
  isCorrect        Boolean?
  isSkipped        Boolean  @default(false)
  order            Int      @default(0) // position within this attempt, fixed at start
  answeredAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  attempt        ExamAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption QuestionOption? @relation("SelectedOption", fields: [selectedOptionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("user_answers")
}

model FlaggedQuestion {
  id         String   @id @default(cuid())
  userId     String
  attemptId  String
  questionId String
  createdAt  DateTime @default(now())

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt  ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("flagged_questions")
}

// Aggregated, denormalized per-user-per-subject stats for fast dashboard reads
// (best score, average, attempt count, improvement trend).
model UserProgress {
  id              String   @id @default(cuid())
  userId          String
  subjectId       String
  attemptsCount   Int      @default(0)
  bestScore       Int      @default(0)
  bestPercentage  Float    @default(0)
  averagePercentage Float  @default(0)
  lastPercentage  Float?
  lastAttemptAt   DateTime?
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@map("user_progress")
}

// ---------------------------------------------------------------------------
// LANDING PAGE CONTENT (admin-editable)
// ---------------------------------------------------------------------------

// The landing page's one-off copy: a single row, always id = "home".
//
// Copy defaults are NOT declared here. `HOME_DEFAULTS` in
// src/server/services/home.ts is the single source of truth, so required columns are
// non-null with no database default — that makes Prisma reject a `create` that forgets a
// field, and keeps the shipped wording in one place instead of two. The public page never
// writes: with no row it renders HOME_DEFAULTS, and the admin PATCH upserts.
model HomePage {
  id String @id @default("home")

  brandLabel String

  // Hero. A blank heroSecondaryLabel drops the second button rather than rendering empty.
  heroBadge          String?
  heroTitle          String  @db.Text
  heroSubtitle       String? @db.Text
  heroPrimaryLabel   String
  heroPrimaryHref    String
  heroSecondaryLabel String?
  heroSecondaryHref  String?

  // Section switches + headings. Turning a section off hides it without deleting its rows.
  statsEnabled Boolean @default(true)

  featuresEnabled  Boolean @default(true)
  featuresTitle    String
  featuresSubtitle String?

  stepsEnabled  Boolean @default(true)
  stepsTitle    String
  stepsSubtitle String?

  faqEnabled   Boolean @default(true)
  faqTitle     String
  faqSubtitle  String?

  ctaEnabled     Boolean @default(true)
  ctaTitle       String
  ctaBody        String? @db.Text
  ctaButtonLabel String
  ctaButtonHref  String

  footerTagline String?

  // Overrides the <title>/<meta description> from the root layout when set.
  metaTitle       String?
  metaDescription String? @db.Text

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation("HomePageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("home_page")
}

// Every repeated landing-page item — a stat, a feature card, a how-it-works step, an FAQ
// entry, a footer link — is one row here, discriminated by `kind`. They share the same
// shape (a heading, some body text, a position, a visibility flag), so one model keeps a
// single admin API and one manager component instead of five near-identical copies.
//
// Which optional columns matter depends on `kind`; the zod schema in
// src/server/validators/home.ts is what enforces that per kind.
model HomeBlock {
  id        String        @id @default(cuid())
  kind      HomeBlockKind
  title     String
  body      String?       @db.Text
  icon      String?       // Lucide icon name, resolved through an allow-list at render time
  metric    HomeMetric    @default(MANUAL) // STAT only
  value     String?       // STAT only: the literal shown when metric is MANUAL
  href      String?       // LINK only
  order     Int           @default(0)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([kind, order])
  @@map("home_blocks")
}

// ---------------------------------------------------------------------------
// GUEST ACCESS (account-free practice)
// ---------------------------------------------------------------------------

// The rotating code that lets someone practise without registering. One row, id = "current".
//
// Two fields carry the access rules, and keeping them separate is what makes the two admin
// actions mean different things:
//
//   `code` / `expiresAt` gate who can COME IN. The 12-hour roll replaces the code and
//   pushes `expiresAt` forward, which stops new redemptions of the old code but leaves
//   everyone already inside alone — their session runs out on its own clock.
//
//   `generation` is the revocation counter, bumped ONLY by an explicit admin reset. Every
//   guest session records the generation it was minted under, so incrementing it invalidates
//   all of them at once.
//
// Rolling is lazy: there is no scheduler. `getActiveCode()` notices an elapsed `expiresAt`
// on its next read and rotates then, so an idle deployment costs nothing.
model GuestAccessCode {
  id String @id @default("current")

  /// Whether account-free access is offered at all.
  isEnabled Boolean @default(true)

  code       String
  /// Bumped only by an admin reset — see the note above.
  generation Int      @default(1)
  issuedAt   DateTime @default(now())
  expiresAt  DateTime

  /// Redemptions of the CURRENT code; reset to 0 whenever the code changes.
  redemptions Int  @default(0)
  /// Cap per code, so a leaked code can't mint unbounded guest rows. Null = no cap.
  maxRedemptions Int? @default(500)

  /// When the retention sweep last ran; it piggybacks on the roll.
  lastPurgeAt DateTime?

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("guest_access_code")
}

// ---------------------------------------------------------------------------
// AUDIT
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
